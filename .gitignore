# Godot generated files
.godot/
*.translation

# Import files
*.import

# Export config (may contain paths/keys)
export_presets.cfg

# Build output
build/

# Piper voice models (local only — used to regenerate assets/voice/)
tools/piper_models/

# Claude/Codex delegation artifacts (local only)
.ai/

# Font download archives (the extracted .ttf is what the game uses)
assets/fonts/*.zip
